"""Chai-1 docking engine for AlchemFold.

Builds a Chai-lab FASTA (protein + ligand) and, for a pocket constraint, a
best-effort restraints CSV, then invokes the ``chai-lab fold`` CLI.

NOTE: Chai-lab's exact CLI flags and restraint-file columns vary by version.
This builds the commonly documented form; use ``run --dry-run`` to inspect and
adjust ``chai_command`` / flags for your installed chai-lab if needed.
"""

from __future__ import annotations

from pathlib import Path

_RESTRAINT_HEADER = (
    "chainA,res_idxA,chainB,res_idxB,connection_type,"
    "confidence,min_distance,max_distance,comment,restraint_id"
)


def validate(conf) -> None:
    """Chai does not predict binding affinity."""
    if getattr(conf, "predict_affinity", False):
        raise ValueError(
            "predict_affinity is only available with engine: boltz (Boltz-2). "
            "Disable it to use the Chai engine."
        )


def _write_fasta(conf, workdir: Path) -> Path:
    lines: list[str] = []
    for protein in getattr(conf, "proteins", []) or []:
        lines.append(f">protein|name={protein.id}")
        lines.append(str(protein.sequence))
    for ligand in getattr(conf, "ligands", []) or []:
        smiles = getattr(ligand, "smiles", None)
        if smiles:
            lines.append(f">ligand|name={ligand.id}")
            lines.append(str(smiles))
        else:
            # Chai takes SMILES; a CCD code is passed through as-is (verify support).
            lines.append(f">ligand|name={ligand.id}")
            lines.append(str(getattr(ligand, "ccd")))
    fasta = workdir / "chai_input.fasta"
    fasta.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return fasta


def _write_restraints(conf, workdir: Path) -> Path | None:
    pocket = getattr(conf, "pocket", None)
    if not pocket:
        return None
    binder = str(pocket.binder)
    max_distance = float(getattr(pocket, "max_distance", 6.0) or 6.0)
    rows = [_RESTRAINT_HEADER]
    for i, contact in enumerate(getattr(pocket, "contacts", []) or [], start=1):
        chain = str(contact.chain)
        residue = int(contact.residue)
        rows.append(
            f"{binder},{binder}1,{chain},{chain}{residue},contact,"
            f"1.0,0.0,{max_distance},pocket,restraint{i}"
        )
    restraints = workdir / "chai_restraints.csv"
    restraints.write_text("\n".join(rows) + "\n", encoding="utf-8")
    return restraints


def write_inputs(conf, workdir: Path) -> tuple[dict, Path]:
    workdir = Path(workdir)
    workdir.mkdir(parents=True, exist_ok=True)
    fasta = _write_fasta(conf, workdir)
    restraints = _write_restraints(conf, workdir)
    out_dir = Path(conf.out_dir)
    if not out_dir.is_absolute():
        out_dir = workdir / out_dir
    inputs = {"fasta": fasta}
    if restraints is not None:
        inputs["restraints"] = restraints
    return inputs, out_dir


def _device(conf) -> str:
    accelerator = str(getattr(conf, "accelerator", "gpu"))
    return "cpu" if accelerator == "cpu" else "cuda:0"


def build_command(conf, inputs: dict, out_dir: Path) -> list[str]:
    import shlex

    command = shlex.split(str(getattr(conf, "chai_command", "chai-lab")))
    command += ["fold", str(inputs["fasta"]), str(out_dir)]
    command += [
        "--num-diffn-samples", str(int(conf.diffusion_samples)),
        "--num-trunk-recycles", str(int(conf.recycling_steps)),
        "--seed", str(int(conf.seed)),
        "--device", _device(conf),
    ]
    if bool(getattr(conf, "use_msa_server", True)):
        command.append("--use-msa-server")
    if "restraints" in inputs:
        command += ["--constraint-path", str(inputs["restraints"])]
    return command


def build_env(conf) -> dict:
    """Extra environment for the Chai run.

    Chai-1 downloads model weights to ``$CHAI_DOWNLOADS_DIR`` (default under
    ``~/.cache``), which on HPC can hit the HOME disk quota. Redirect it to the
    configured ``cache_dir`` (or the CHEMFLOW_MODEL_CACHE env var).
    """
    import os
    from pathlib import Path

    cache = (getattr(conf, "cache_dir", None)
             or os.environ.get("CHEMFLOW_MODEL_CACHE"))
    if not cache:
        return {}
    return {"CHAI_DOWNLOADS_DIR": str(Path(cache).expanduser())}
