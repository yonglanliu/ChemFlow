"""Per-module SLURM presets: built-in files plus one user override file.

Each module owns a YAML in this package (``docking.yaml``, ``screening.yaml``,
``openfe.yaml``, ``gromacs.yaml``, ``openmm.yaml``, ``mmgbsa.yaml``) with its
own ``presets``, ``defaults``, ``gpu_types`` and ``default_preset``. A site
overrides any of it from a single user file, looked up in this order (first
found wins):

    1. ``$CHEMFLOW_HPC_CONFIG``
    2. ``<PROJECT_ROOT>/env/hpc.yaml``
    3. ``~/.config/chemflow/hpc.yaml``

Within that file, a top-level ``presets``/``defaults``/``gpu_types``/
``default_preset`` applies to every module, and a section named after the
module overrides it again — so the historical layout keeps working::

    defaults: {...}          # all modules
    presets: {...}           # all modules
    docking:                 # just docking
      presets: {...}

Resolution order per module, each layer overriding the previous:

    _common.yaml
      -> user top-level defaults/gpu_types     (site-wide: partition names, account)
      -> <module>.yaml                         (module intent beats site-wide defaults)
      -> user <module>: section                (the last word)

Module intent deliberately outranks the user's *top-level* defaults: a
site-wide ``partition: gpu`` must not turn the CPU-only MM-GBSA preset into a
GPU job. To change one module, put it in that module's section.

A user's top-level ``presets``/``default_preset`` is legacy — those keys were
historically shared by the OpenFE and docking paths, so they still apply there
(and nowhere else). New presets belong in a module section.

Nothing here renders a script; :mod:`hpc.slurm` does that.
"""

from __future__ import annotations

import copy
import os
from functools import lru_cache
from pathlib import Path
from typing import Any

from hpc.resources import Resources, normalize_keys

MODULES = ("docking", "screening", "openfe", "gromacs", "openmm", "mmgbsa")

_PRESET_DIR = Path(__file__).resolve().parent


def config_path() -> Path | None:
    """The user override file that will be used, or None (built-ins only)."""
    env = os.environ.get("CHEMFLOW_HPC_CONFIG", "").strip()
    candidates: list[Path | None] = [Path(env).expanduser() if env else None]
    try:
        from chemflow.config import PROJECT_ROOT

        candidates.append(Path(PROJECT_ROOT) / "env" / "hpc.yaml")
    except Exception:
        candidates.append(Path(__file__).resolve().parents[3] / "env" / "hpc.yaml")
    candidates.append(Path.home() / ".config" / "chemflow" / "hpc.yaml")
    for candidate in candidates:
        if candidate and candidate.is_file():
            return candidate.resolve()
    return None


def _read_yaml(path: Path) -> dict[str, Any]:
    try:
        import yaml

        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


@lru_cache(maxsize=None)
def _builtin(name: str) -> dict[str, Any]:
    path = _PRESET_DIR / f"{name}.yaml"
    return _read_yaml(path) if path.is_file() else {}


def _normalize_presets(raw: Any) -> dict[str, Any]:
    """``{name: walltime-or-mapping}`` with mapping keys canonicalised."""
    if not isinstance(raw, dict):
        return {}
    out: dict[str, Any] = {}
    for key, value in raw.items():
        out[str(key)] = normalize_keys(value) if isinstance(value, dict) else str(value)
    return out


def _apply_layer(settings: dict[str, Any], layer: dict[str, Any], *,
                 with_presets: bool = True, with_defaults: bool = True) -> None:
    """Merge one YAML layer (defaults/presets/gpu_types/default_preset) in place."""
    if with_defaults and isinstance(layer.get("defaults"), dict):
        settings["defaults"].update(normalize_keys(layer["defaults"]))
    if isinstance(layer.get("gpu_types"), list):
        settings["gpu_types"] = ["" if g is None else str(g) for g in layer["gpu_types"]]
    if not with_presets:
        return
    presets = _normalize_presets(layer.get("presets"))
    if presets:
        settings["presets"] = presets          # replace, never merge name-by-name
    if layer.get("default_preset"):
        settings["default_preset"] = str(layer["default_preset"])


# Modules whose presets a user's TOP-LEVEL `presets:` block still feeds. Those
# keys predate per-module files and were shared by these two paths; everywhere
# else, presets must come from a module section.
_LEGACY_TOPLEVEL = ("openfe", "docking")


def settings(module: str) -> dict[str, Any]:
    """Fully resolved ``{defaults, presets, gpu_types, default_preset}``."""
    resolved: dict[str, Any] = {"defaults": {}, "presets": {}, "gpu_types": [""],
                                "default_preset": ""}
    _apply_layer(resolved, _builtin("_common"))

    user = _read_yaml(config_path()) if config_path() is not None else {}
    # Site-wide user defaults land BEFORE the module file, so module intent wins.
    _apply_layer(resolved, user, with_presets=False)
    _apply_layer(resolved, _builtin(module))
    if module in _LEGACY_TOPLEVEL:
        _apply_layer(resolved, user, with_defaults=False)
    section = user.get(module)
    if isinstance(section, dict):
        _apply_layer(resolved, section)               # module section wins
    return copy.deepcopy(resolved)


def names(module: str) -> list[str]:
    """Preset names for a dropdown, in file order."""
    return list(settings(module)["presets"])


def gpu_types(module: str = "docking") -> list[str]:
    """Selectable ``--gres`` GPU types; ``""`` means any GPU."""
    return settings(module)["gpu_types"]


def default_name(module: str) -> str:
    """The configured default preset, guaranteed to exist (else the first one)."""
    resolved = settings(module)
    chosen = resolved["default_preset"]
    available = resolved["presets"]
    if chosen in available:
        return chosen
    return next(iter(available), "")


def defaults(module: str) -> Resources:
    """The module's resources with no preset applied."""
    return Resources.from_mapping(settings(module)["defaults"])


def resources(module: str, name: str | None = None,
              override: dict[str, Any] | None = None) -> Resources:
    """Resolve a preset to concrete :class:`~hpc.resources.Resources`.

    ``name`` defaults to the module's default preset. A preset is either a bare
    walltime string or a mapping of any canonical key. ``override`` (any
    dialect) is applied last, so a desktop form or CLI flag always wins.
    Raises ``KeyError`` for an unknown preset name.
    """
    resolved = settings(module)
    base = Resources.from_mapping(resolved["defaults"])
    chosen = name if name is not None else default_name(module)
    if chosen:
        preset = resolved["presets"].get(chosen)
        if preset is None:
            raise KeyError(chosen)
        base = base.merged({"time": preset} if isinstance(preset, str) else preset)
    return base.merged(override)


def single_gpu_names(module: str) -> list[str]:
    """Presets that ask for at most one GPU.

    Some renderers run exactly one process per array task and would silently
    ignore a multi-GPU request; they show only these.
    """
    out = []
    for name in names(module):
        try:
            if resources(module, name).gpus <= 1:
                out.append(name)
        except KeyError:
            continue
    return out
