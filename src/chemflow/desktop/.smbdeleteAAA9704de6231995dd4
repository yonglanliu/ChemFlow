"""AI docking & virtual screening (Boltz-2 / Chai-1) via the ``alchemfold`` CLI.

Two modes on one page:

* **Docking** — a single ligand against the receptor. Provide the ligand as a
  SMILES string, or upload a file (SDF / .smi / CSV / .cxsmiles). Drives
  ``alchemfold dock {generate,validate,stage,run}``.
* **Virtual screening** — a ligand library sharded across a SLURM array, then
  ranked. Pick the source catalog (ZINC22 / Enamine REAL). Drives
  ``alchemfold screen {generate,validate,stage,rank}``.

A 3Dmol.js panel renders the predicted complex / binding pose. Everything runs
through the dedicated ``alchemfold`` conda env.
"""

from __future__ import annotations

from pathlib import Path

from PySide6.QtWidgets import (
    QCheckBox,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QPlainTextEdit,
    QVBoxLayout,
    QWidget,
)

from chemflow.desktop.widgets.forms import (
    NoScrollComboBox,
    NoScrollSpinBox,
    PageHeader,
    PathField,
    action_button,
)

try:  # QtWebEngine may be unavailable in some minimal installs; degrade gracefully.
    from chemflow.desktop.widgets.molecule3d_view import Molecule3DView
except Exception:  # pragma: no cover - import guard
    Molecule3DView = None


_MODE_DOCK = "Docking (single ligand)"
_MODE_SCREEN = "Virtual screening (library)"

_BUILTIN_PRESETS = {
    "singlenode-singlegpu-quick": "04:00:00",
    "singlenode-singlegpu-day": "1-00:00:00",
    "singlenode-singlegpu-long": "4-00:00:00",
    "singlenode-singlegpu-week": "7-00:00:00",
    "singlenode-singlegpu-tendays": "10-00:00:00",
}
_BUILTIN_GPUS = ["", "a100", "v100x", "p100", "v100", "l40"]
_BUILTIN_DEFAULT_PRESET = "singlenode-singlegpu-day"


def _hpc_settings() -> tuple[list[str], list[str], str]:
    """Return (preset_names, gpu_types, default_preset) from env/hpc.yaml.

    Reads the same customizable file the alchemfold CLI uses, so the desktop
    dropdowns stay in sync with cluster customizations. Falls back to built-ins.
    """
    import os
    from pathlib import Path

    try:
        import yaml
        from chemflow.config import PROJECT_ROOT

        env = os.environ.get("CHEMFLOW_HPC_CONFIG", "").strip()
        candidates = [
            Path(env).expanduser() if env else None,
            PROJECT_ROOT / "env" / "hpc.yaml",
            Path.home() / ".config" / "chemflow" / "hpc.yaml",
        ]
        for candidate in candidates:
            if candidate and candidate.is_file():
                data = yaml.safe_load(candidate.read_text(encoding="utf-8")) or {}
                presets = {str(k): str(v) for k, v in (data.get("presets") or _BUILTIN_PRESETS).items()}
                gpus = ["" if g is None else str(g) for g in (data.get("gpu_types") or _BUILTIN_GPUS)]
                dp = str(data.get("default_preset") or _BUILTIN_DEFAULT_PRESET)
                names = list(presets.keys())
                return names, gpus, (dp if dp in presets else (names[0] if names else _BUILTIN_DEFAULT_PRESET))
    except Exception:
        pass
    return list(_BUILTIN_PRESETS.keys()), list(_BUILTIN_GPUS), _BUILTIN_DEFAULT_PRESET


def _default_cache_dir() -> str:
    """A non-HOME default for the model-cache field (/data or scratch)."""
    import getpass
    import os

    for var in ("CHEMFLOW_MODEL_CACHE", "CHEMFLOW_BOLTZ_CACHE", "BOLTZ_CACHE"):
        value = os.environ.get(var)
        if value:
            return os.path.expanduser(value)
    try:
        user = os.environ.get("USER") or getpass.getuser()
    except Exception:
        user = ""
    if user:
        for base in ("/data", "/scratch", "/gpfs/data", "/vf/users"):
            candidate = os.path.join(base, user)
            if os.path.isdir(candidate):
                return os.path.join(candidate, ".alchemfold_cache")
    return ""


class CofoldScreeningPage(QWidget):
