    # -- mode handling ----------------------------------------------------
    def _is_dock(self) -> bool:
        return self.mode.currentText() == _MODE_DOCK

    def _is_hpc(self) -> bool:
        return self.run_on.currentText().startswith("HPC")

    def _gpu_value(self) -> str:
        idx = self.gpu_type.currentIndex()
        if 0 <= idx < len(self._gpu_values):
            return self._gpu_values[idx]
        return ""

    def _on_mode_changed(self, _text: str) -> None:
        dock = self._is_dock()
        self._dock_box.setVisible(dock)
        self._screen_box.setVisible(not dock)
        default_cfg = "docking.yaml" if dock else "screen.yaml"
        if self.config.text() in ("", "docking.yaml", "screen.yaml"):
            self.config.setText(default_cfg)
        if dock:
            self._on_run_target_changed(self.run_on.currentText())
        else:
            self._update_buttons()
            self.status.setText("Generate a config, add ligand_files + sequence, Validate, "
                                "Stage (submits the SLURM array), then Rank once it finishes.")

    def _on_run_target_changed(self, _text: str) -> None:
        hpc = self._is_hpc()
        self.hpc_preset.setEnabled(hpc)
        self.gpu_type.setEnabled(hpc)
        self._cpu_warn.setVisible(not hpc)
        self._update_buttons()
        if self._is_dock():
            if hpc:
                self.status.setText(f"HPC mode ({self.hpc_preset.currentText()}): Generate, "
                                    "Validate, Stage (.slurm), then Submit to SLURM.")
            else:
                self.status.setText("localhost: add a ligand (SMILES or file) + sequence, "
                                    "Generate, Validate, then Run docking.")

    def _update_buttons(self) -> None:
        if not self._is_dock():
            self._btn_stage.setText("Stage (shard + SLURM array)")
            self._btn_action.setText("Rank hits")
        elif self._is_hpc():
            self._btn_stage.setText("Stage (.slurm)")
            self._btn_action.setText("Submit to SLURM")
        else:
            self._btn_stage.setText("Stage (local runner)")
            self._btn_action.setText("Run docking")

    # -- helpers ----------------------------------------------------------
    def _cfg(self) -> str:
        default = "docking.yaml" if self._is_dock() else "screen.yaml"
        return str(Path(self.config.text().strip() or default).expanduser())

    def _run(self, argv: list[str]) -> None:
        if self._console is not None:
            # Run in the config's directory so outputs (slurm script,
            # docking_output/, shards) land there, consistent with the sbatch cwd.
            cwd = str(Path(self._cfg()).expanduser().resolve().parent)
            self._console.run_alchemfold(argv, cwd=cwd)

    def _noun(self) -> str:
        return "dock" if self._is_dock() else "screen"

    # -- actions ----------------------------------------------------------
    def _generate(self) -> None:
        cfg = self._cfg()
        seq = self.sequence.toPlainText().strip()
        if self._is_dock():
            argv = ["dock", "generate", "--engine", self.engine.currentText(), "-o", cfg]
            lig_file = self.ligand_file.text().strip()
            smiles = self.smiles.text().strip()
            if lig_file:
                argv += ["--ligand-file", lig_file]
            elif smiles:
                argv += ["--smiles", smiles]
            if seq:
                argv += ["--sequence", seq]
            argv += ["--diffusion-samples", str(self.diffusion_samples.value()),
                     "--recycling-steps", str(self.recycling_steps.value()),
                     "--sampling-steps", str(self.sampling_steps.value())]
            argv.append("--use-msa-server" if self.use_msa_server.isChecked()
                        else "--no-use-msa-server")
            if self.no_kernels.isChecked():
                argv.append("--no-kernels")
            if self.use_pocket.isChecked():
                contacts = self.pocket_contacts.text().strip()
                if contacts:
                    argv += ["--pocket-contacts", contacts]
                    binder = self.pocket_binder.text().strip()
                    if binder:
                        argv += ["--pocket-binder", binder]
                    md = self.pocket_max_distance.text().strip()
                    if md:
                        argv += ["--pocket-max-distance", md]
                else:
                    # No residues given yet — emit a placeholder block to edit by hand.
                    argv.append("--pocket")
            cache = self.cache_dir.text().strip()
            if cache:
                argv += ["--cache-dir", cache]
            self._run(argv)
            src = f"file {lig_file}" if lig_file else (f"SMILES {smiles}" if smiles else "placeholder ligand")
            self.status.setText(f"Writing {cfg} (engine: {self.engine.currentText()}, "
                                f"ligand: {src}). Review it, then Validate.")
        else:
            argv = ["screen", "generate", "--engine", self.engine.currentText(),
                    "--library", self.library.currentText(), "-o", cfg]
            if seq:
                argv += ["--sequence", seq]
            self._run(argv)
            self.status.setText(f"Writing {cfg} (engine: {self.engine.currentText()}, "
                                f"library: {self.library.currentText()}). "
                                "Add ligand_files, then Validate.")

    def _validate(self) -> None:
        self._run([self._noun(), "validate", self._cfg()])

    def _stage(self) -> None:
        if not self._is_dock():
            self._run(["screen", "stage", self._cfg()])
            return
        if self._is_hpc():
            argv = ["dock", "stage", "--target", "hpc",
                    "--hpc-preset", self.hpc_preset.currentText()]
            gpu = self._gpu_value()
            if gpu:
                argv += ["--gpu-type", gpu]
            argv.append(self._cfg())
            self._run(argv)
            self.status.setText(f"Writing run_docking.slurm ({self.hpc_preset.currentText()}"
                                + (f", gpu:{gpu}" if gpu else "") + "). Then Submit to SLURM.")
        else:
            self._run(["dock", "stage", self._cfg()])

    def _final_action(self) -> None:
        if not self._is_dock():
            self._run(["screen", "rank", self._cfg()])
            return
        if self._is_hpc():
            job_dir = Path(self._cfg()).expanduser().resolve().parent
            slurm = job_dir / "run_docking.slurm"
            if self._console is not None:
                self._console.run_program("sbatch", [str(slurm)], cwd=str(job_dir))
            self.status.setText(f"Submitting {slurm.name} with sbatch. Load the predicted "
                                "complex below once the job finishes.")
        else:
            self._run(["dock", "run", self._cfg()])
            self.status.setText("Running docking in the alchemfold env. When it finishes, "
                                "load the predicted complex below to see the pose.")

    def _show_pose(self) -> None:
        path = self.result_path.text().strip()
        if not path:
            self.status.setText("Choose a predicted complex (PDB / mmCIF) to view its pose.")
            return
        if self.viewer is not None:
            self.viewer.load_structure(path)
            self.status.setText(f"Showing {Path(path).name} — receptor cartoon + ligand sticks.")
