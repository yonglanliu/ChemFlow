        self.addTab(self._job_tab(), "5 · Job (HPC)")
        self.addTab(self._exec_tab(), "Execution")

    # -- tabs --------------------------------------------------------------
    def _wrap(self, header, form_widget):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.addWidget(header)
        layout.addWidget(form_widget)
        layout.addStretch()
        return page

