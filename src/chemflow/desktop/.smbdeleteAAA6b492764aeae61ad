def _hpc_gpu_types(module: str) -> list[str]:
    """Selectable --gres GPU types from the shared hpc presets (one list, repo-wide)."""
    try:
        from hpc import presets as _presets

        return _presets.gpu_types(module)
    except Exception:          # hpc not importable -> a safe built-in list
        return ["", "a100", "a100x", "v100", "v100x", "h100", "p100", "a40", "rtx8000"]

class _EdgeBridge(QObject):
    edge_clicked = Signal(str, str)
    node_clicked = Signal(str)

    @Slot(str, str)
    def on_edge_clicked(self, a: str, b: str) -> None:
        self.edge_clicked.emit(a, b)

    @Slot(str)
    def on_node_clicked(self, name: str) -> None:
        self.node_clicked.emit(name)


def _web_view():
    from PySide6.QtWebEngineWidgets import QWebEngineView

    return QWebEngineView()


def _combo(items, current):
    box = QComboBox()
    box.addItems(items)
    if current in items:
        box.setCurrentText(current)
    return box


def _dspin(value, lo, hi, step=0.1, decimals=3):
    s = QDoubleSpinBox()
    s.setRange(lo, hi)
    s.setDecimals(decimals)
    s.setSingleStep(step)
    s.setValue(value)
    return s


def _spin(value, lo, hi):
    s = QSpinBox()
    s.setRange(lo, hi)
    s.setValue(value)
    return s


class OpenFERbfeWorkflowPage(QTabWidget):
