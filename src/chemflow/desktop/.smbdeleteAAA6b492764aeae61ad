        self.preeq_nvt_ps = QDoubleSpinBox()
        self.preeq_nvt_ps.setRange(0.0, 10000.0)
        self.preeq_nvt_ps.setDecimals(0)
        self.preeq_nvt_ps.setValue(100.0)
