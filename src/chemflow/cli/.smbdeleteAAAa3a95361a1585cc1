"""``chemflow diffdock-env`` — install DiffDock-L in its OWN conda env.

DiffDock-L (gcorso/DiffDock) is a GitHub project that needs the PyTorch-Geometric stack, so it
lives in a dedicated env (default name ``diffdock``) — never inside ``alchemfold``. This
command creates that env from ``env/environment-diffdock.yaml``, clones the DiffDock repo, and
records where both are so AlchemFold / the desktop can run it::

    chemflow diffdock-env install                              # env + <ChemFlow>/DiffDock (CUDA 12.1 wheels)
    chemflow diffdock-env install --cuda 11.8                  # use cu118 torch + PyG wheels
    chemflow diffdock-env install --profile repo               # use <dir>/environment.yml instead
    chemflow diffdock-env install --dry-run                    # print the commands only
    chemflow diffdock-env install --no-link-chemflow           # skip `pip install -e chemflow` in the env
    chemflow diffdock-env status                               # env, repo, models, GPU
    chemflow diffdock-env warmup                               # first run: downloads models/ESM2,
                                                               #   builds SO(2)/SO(3) tables (needs internet)

The recorded location is ``~/.config/chemflow/diffdock.yaml`` (keys ``dir`` and ``python``);
``$CHEMFLOW_DIFFDOCK_DIR`` / ``$CHEMFLOW_DIFFDOCK_PYTHON`` override it.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

_DEFAULT_ENV = "diffdock"
_REPO_URL = "https://github.com/gcorso/DiffDock.git"
_YAML_CUDA = "cu121"  # the CUDA tag written in env/environment-diffdock.yaml
_CONFIG_FILE = Path.home() / ".config" / "chemflow" / "diffdock.yaml"


def default_dir() -> Path:
    """Where to clone DiffDock: $CHEMFLOW_DIFFDOCK_DIR, else ``<ChemFlow root>/DiffDock`` —
    a sibling of ``src/`` (like REINVENT4/ and pmx/), so it is not in HOME (small HPC quota)."""
    env = os.environ.get("CHEMFLOW_DIFFDOCK_DIR", "").strip()
    return Path(env).expanduser() if env else _repo_root() / "DiffDock"


def _conda_tool(prefer_mamba: bool = True) -> str | None:
    order = ("mamba", "conda") if prefer_mamba else ("conda", "mamba")
    for tool in order:
        if shutil.which(tool):
            return tool
    return None


def _repo_root() -> Path:
    here = Path(__file__).resolve()
    for parent in here.parents:
        if (parent / "env" / "environment-diffdock.yaml").is_file():
            return parent
    return here.parents[3]


def _env_exists(tool: str, env: str) -> bool:
    return subprocess.run([tool, "run", "-n", env, "python", "-c", ""],
                          capture_output=True).returncode == 0


def yaml_for_cuda(yaml_text: str, cuda: str | None) -> str:
    """Return the env YAML with the CUDA tag swapped (``12.4`` -> ``cu124``)."""
    if not cuda:
        return yaml_text
    tag = "cu" + str(cuda).replace(".", "")
    return yaml_text.replace(_YAML_CUDA, tag)


def _real_entries(path: Path) -> list[str]:
    """Entries in ``path`` ignoring SMB ``.smbdelete*`` placeholders left by network mounts."""
    try:
        return [n for n in os.listdir(path) if not n.startswith(".smbdelete")]
    except OSError:
        return []


def clone_commands(repo_dir: Path, url: str = _REPO_URL) -> list[list[str]]:
    """Commands that put the DiffDock repo in ``repo_dir`` (clone, update, or fetch-in-place)."""
    d = str(repo_dir)
    if (repo_dir / ".git").is_dir():
        return [["git", "-C", d, "pull", "--ff-only"]]
    if repo_dir.is_dir() and os.listdir(repo_dir) and not _real_entries(repo_dir):
        # Only network-mount placeholder files: `git clone` would refuse a non-empty dir, so
        # initialise in place and fetch instead.
        return [["git", "-C", d, "init", "-q"],
                ["git", "-C", d, "remote", "add", "origin", url],
                ["git", "-C", d, "fetch", "--depth", "1", "origin", "main"],
                ["git", "-C", d, "checkout", "-q", "-B", "main", "FETCH_HEAD"]]
    return [["git", "clone", "--depth", "1", url, d]]


def env_commands(env: str, yaml_path: str, *, tool: str, exists: bool) -> list[list[str]]:
    if exists:
        return [[tool, "env", "update", "-n", env, "-f", yaml_path]]
    return [[tool, "env", "create", "-y", "-n", env, "-f", yaml_path]]


def write_location(repo_dir: Path, python: str) -> Path:
    _CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    _CONFIG_FILE.write_text(
        "# written by `chemflow diffdock-env install`\n"
        f'dir: "{repo_dir}"\n'
        f'python: "{python}"\n', encoding="utf-8")
    return _CONFIG_FILE


def read_location() -> dict:
    """Recorded DiffDock location (pure-stdlib parse of the 2-key file)."""
    out: dict = {}
    try:
        for line in _CONFIG_FILE.read_text(encoding="utf-8").splitlines():
            m = re.match(r'\s*(dir|python)\s*:\s*"?([^"#]+?)"?\s*(#.*)?$', line)
            if m:
                out[m.group(1)] = m.group(2).strip()
    except OSError:
        pass
    return out


def _env_python(tool: str, env: str) -> str | None:
    proc = subprocess.run([tool, "run", "-n", env, "python", "-c", "import sys;print(sys.executable)"],
                          capture_output=True, text=True)
    lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
    return lines[-1].strip() if proc.returncode == 0 and lines else None


def _install(args) -> int:
    tool = args.tool or _conda_tool()
    if not tool:
        print("error: neither mamba nor conda found on PATH. On HPC, load conda first, "
              "then retry; otherwise install Miniforge.", file=sys.stderr)
        return 1
    repo_dir = Path(args.dir).expanduser().resolve() if args.dir else default_dir().resolve()
    exists = _env_exists(tool, args.env)
    commands: list[list[str]] = []
    if args.recreate and exists:
        commands.append([tool, "env", "remove", "-y", "-n", args.env])
        exists = False
    elif exists:
        print(f"Environment '{args.env}' already exists — updating it "
              f"(use --recreate for a clean rebuild).")

    commands += clone_commands(repo_dir, args.repo_url)
    tmp: Path | None = None
    if args.profile == "repo":
        yaml_path = str(repo_dir / "environment.yml")  # exists only after the clone
        print(f"Profile 'repo': building the env from {yaml_path}")
    else:
        src = _repo_root() / "env" / "environment-diffdock.yaml"
        if not src.is_file():
            print(f"error: {src} not found", file=sys.stderr)
            return 1
        text = yaml_for_cuda(src.read_text(encoding="utf-8"), args.cuda)
        tmp = Path(tempfile.mkdtemp(prefix="diffdock_env_")) / "environment-diffdock.yaml"
        tmp.write_text(text, encoding="utf-8")
        yaml_path = str(tmp)
        if args.cuda:
            print(f"Using CUDA {args.cuda} wheels (cu{args.cuda.replace('.', '')}).")
    commands += env_commands(args.env, yaml_path, tool=tool, exists=exists)

    for command in commands:
        print("$ " + " ".join(command))
        if args.dry_run:
            continue
        rc = subprocess.run(command, check=False).returncode
        if rc != 0:
            print(f"error: command failed (exit {rc}): {' '.join(command)}", file=sys.stderr)
            return rc

    # Link chemflow into the env (editable, no deps) so `chemflow ...` runs through it. Optional:
    # needs Python >=3.11 in the env, so it is a soft step (the profile 'repo' env is older).
    if args.link_chemflow:
        link = [tool, "run", "-n", args.env, "pip", "install", "-e", str(_repo_root()),
                "--no-deps", "--no-build-isolation"]
        print("$ " + " ".join(link))
        if not args.dry_run:
            if subprocess.run(link, check=False).returncode != 0:
                print("warning: could not link chemflow into the env (it needs Python >=3.11; "
                      "profile 'repo' envs are older). DiffDock itself is unaffected — AlchemFold "
                      "runs it by interpreter path.", file=sys.stderr)
    if args.dry_run:
        return 0

    python = _env_python(tool, args.env)
    if python:
        where = write_location(repo_dir, python)
        print(f"\nRecorded DiffDock location in {where}\n  dir:    {repo_dir}\n  python: {python}")
    if str(repo_dir).startswith(str(Path.home())):
        print(f"\nNote: DiffDock is under your HOME ({repo_dir}); the models + ESM2 weights "
              "(a few GB) count against its quota. Use --dir <big disk>/DiffDock to avoid that.")
    print(f"\nDiffDock-L env '{args.env}' is ready. Next, on a node WITH internet run once:\n"
          f"    chemflow diffdock-env warmup\n"
          f"(downloads the DiffDock-L models + ESM2 weights and builds the lookup tables).")
    return 0


def _status(args) -> int:
    tool = args.tool or _conda_tool()
    loc = read_location()
    repo_dir = Path(os.environ.get("CHEMFLOW_DIFFDOCK_DIR") or args.dir or loc.get("dir")
                    or default_dir()).expanduser()
    print(f"DiffDock environment: {args.env}")
    ok_repo = (repo_dir / "inference.py").is_file()
    print(f"  repo      {repo_dir}  -> {'found ✓' if ok_repo else 'NOT found (run install --dir …)'}")
    models = repo_dir / "workdir"
    have_models = models.is_dir() and any(models.iterdir()) if models.is_dir() else False
    print(f"  models    {models}  -> {'present ✓' if have_models else 'not downloaded yet (run warmup)'}")
    if not tool:
        print("  (no conda/mamba on PATH to inspect the env)")
        return 0
    probe = ("import importlib,sys\n"
             "for m in ('torch','torch_geometric','torch_scatter','e3nn','esm','rdkit','spyrmsd','chemflow'):\n"
             "    try:\n"
             "        mod=importlib.import_module(m); print(m, getattr(mod,'__version__','ok'))\n"
             "    except Exception as e:\n"
             "        print(m, 'MISSING', type(e).__name__)\n"
             "import torch; print('cuda', torch.cuda.is_available(), torch.cuda.device_count())\n")
    proc = subprocess.run([tool, "run", "-n", args.env, "python", "-c", probe],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        print(f"  env '{args.env}' not usable: {(proc.stderr or '').strip().splitlines()[-1:]}")
        return 0
    for line in proc.stdout.splitlines():
        parts = line.split()
        if not parts:
            continue
        if parts[0] == "cuda":
            print(f"  GPU       visible={parts[1]} count={parts[2]}"
                  + ("  (login nodes usually show none)" if parts[1] == "False" else ""))
        else:
            print(f"  {parts[0]:14s}-> {' '.join(parts[1:])}")
    return 0


def _warmup(args) -> int:
    loc = read_location()
    repo_dir = Path(args.dir or os.environ.get("CHEMFLOW_DIFFDOCK_DIR") or loc.get("dir")
                    or default_dir()).expanduser()
    python = os.environ.get("CHEMFLOW_DIFFDOCK_PYTHON") or loc.get("python")
    if not python:
        tool = _conda_tool()
        python = _env_python(tool, args.env) if tool else None
    if not (repo_dir / "inference.py").is_file() or not python:
        print("error: DiffDock not installed — run `chemflow diffdock-env install` first.",
              file=sys.stderr)
        return 1
    example = repo_dir / "data" / "protein_ligand_example.csv"
    out = Path(tempfile.mkdtemp(prefix="diffdock_warmup_"))
    cmd = [python, "-m", "inference", "--config", "default_inference_args.yaml",
           "--protein_ligand_csv", str(example), "--out_dir", str(out),
           "--samples_per_complex", "1", "--inference_steps", "2"]
    print("$ (cd %s) %s" % (repo_dir, " ".join(cmd)))
    if args.dry_run:
        return 0
    env = os.environ.copy()
    env.setdefault("TORCH_HOME", str(repo_dir / "torch_cache"))  # ESM2 weights next to the repo, not in HOME
    print(f"ESM2 weights cache (TORCH_HOME): {env['TORCH_HOME']}")
    rc = subprocess.run(cmd, cwd=str(repo_dir), check=False, env=env).returncode
    print("Warm-up finished." if rc == 0 else f"Warm-up failed (exit {rc}); see the output above.")
    return rc


def add_diffdock_env_parser(subparsers) -> None:
    parser = subparsers.add_parser(
        "diffdock-env", help="Install DiffDock-L in its own conda env (separate from alchemfold)")
    commands = parser.add_subparsers(dest="diffdock_env_command", required=True)

    install = commands.add_parser("install", help="Create the env and clone the DiffDock repo")
    install.add_argument("--env", default=_DEFAULT_ENV, help=f"conda env name (default {_DEFAULT_ENV})")
    install.add_argument("--dir", default=None,
                         help="where to clone DiffDock (default: $CHEMFLOW_DIFFDOCK_DIR, else "
                              "<ChemFlow root>/DiffDock, next to src/)")
    install.add_argument("--cuda", default=None,
                         help="CUDA tag for the torch/PyG wheels, e.g. 11.8 | 12.1 | 12.4 (default: 12.1)")
    install.add_argument("--profile", choices=["modern", "repo"], default="modern",
                         help="modern: env/environment-diffdock.yaml (torch 2.4, runs on A100/L40/H200). "
                              "repo: DiffDock's own environment.yml (older pinned torch)")
    install.add_argument("--recreate", action="store_true", help="remove the env first and rebuild")
    install.add_argument("--link-chemflow", action=argparse.BooleanOptionalAction, default=True,
                         help="pip install -e chemflow into the env (--no-deps; default: on)")
    install.add_argument("--repo-url", default=_REPO_URL, help="DiffDock git URL")
    install.add_argument("--tool", default=None, help="mamba | conda (default: mamba if present)")
    install.add_argument("--dry-run", action="store_true", help="print the commands only")
    install.set_defaults(func=_install)

    status = commands.add_parser("status", help="Show env, repo, models and GPU visibility")
    status.add_argument("--env", default=_DEFAULT_ENV)
    status.add_argument("--dir", default=None)
    status.add_argument("--tool", default=None)
    status.set_defaults(func=_status)

    warmup = commands.add_parser(
        "warmup", help="First run: download DiffDock-L models + ESM2 and build lookup tables "
                       "(needs internet; run on a login/data node)")
    warmup.add_argument("--env", default=_DEFAULT_ENV)
    warmup.add_argument("--dir", default=None)
    warmup.add_argument("--dry-run", action="store_true")
    warmup.set_defaults(func=_warmup)
