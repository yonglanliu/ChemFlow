"""``chemflow active-learn`` — active-learning virtual screening driver.

    chemflow active-learn generate -o al.yaml     # write a commented config
    chemflow active-learn run al.yaml [--dry-run]  # run the loop (Glide oracle + Chemprop)
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TEMPLATE = """\
# ===================================================================
# ChemFlow active-learning virtual screening (Deep-Docking style).
#
# A Chemprop surrogate scores the whole sharded library each round; the Glide
# oracle only docks the batch that acquisition selects. Fill in the three command
# templates for YOUR cluster (placeholders in {braces} are filled per round).
# ===================================================================

workdir: al_run                 # all round outputs + labels.csv + top_hits.csv go here
library_shards: "shards/*.smi"  # sharded library: 'id<TAB>smiles' per line (id first)

rounds: 5                       # active-learning iterations
seed_size: 2000                 # round-0 random sample to dock
batch_size: 2000                # compounds docked per subsequent round
strategy: ucb                   # greedy | ucb | thompson | random
kappa: 1.0                      # UCB exploration weight (ucb strategy)
lower_is_better: true           # docking score: more negative = better
top_n: 500                      # how many final hits to emit
seed: 0

# --- Seed (round-0) selection ----------------------------------------------
seed_method: diverse            # random | diverse (MaxMin, default) | scaffold (Butina)
seed_pool: 0                    # oversample the diverse/scaffold pick draws from (0 = ~20x seed_size)
seed_actives: ""               # optional SMILES file of known binders to warm-start the seed

# --- Oracle (docking) ------------------------------------------------------
oracle: glide                   # glide | vsw | vina | custom
receptor: "grid.zip"            # Glide grid .zip  (for vina: receptor .pdbqt)
modules: []                     # `module load` these before the oracle, e.g.
                                #   [schrodinger]           # Glide / VSW
                                #   [autodock-vina, openbabel]  # Vina
# Enamine REAL is raw SMILES, so the oracle wrapper must run LIGAND PREP then dock.
# Built-in wrappers (you provide the script): read the batch .smi (SMILES<TAB>id),
# prep + dock against {receptor}, and WRITE {out} as CSV 'id,score':
#   glide -> glide_dock.sh {batch} {receptor} {out}   # LigPrep -> Glide SP/XP
#   vsw   -> vsw_dock.sh   {batch} {receptor} {out}   # Schrodinger VSW (prep + HTVS->SP->XP)
#   vina  -> vina_dock.sh  {batch} {receptor} {out}   # Meeko/OpenBabel -> Vina
# Override with a full custom command here (leave empty to use the built-in):
oracle_command: ""

# --- Library format (Enamine REAL .cxsmiles = SMILES col 0, ID col 1) ------
smiles_column: 0
id_column: 1

# --- Surrogate: train + predict (ChemFlow) ---------------------------------
# train: fit on cumulative {labels} (id,score) -> {model}
train_command: "chemflow train chemprop --data {labels} --out {model}"
# predict over the whole library -> {out} CSV with 'id,pred' (+ 'sigma' for UCB/Thompson)
predict_command: "chemflow predict --model {model} --library {library} --out {out} --uncertainty"

# TIP: for 10^8-10^9 libraries run train/predict as SLURM array jobs over the
# shards and have the command block until they finish (e.g. sbatch --wait), so
# each round's predict covers the full space before acquisition.
"""


def _generate(args: argparse.Namespace) -> int:
    out = Path(args.output) if args.output else Path("al.yaml")
    out = out.expanduser()
    if out.exists() and not args.force:
        print(f"Refusing to overwrite existing file: {out} (use --force)", file=sys.stderr)
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(_TEMPLATE, encoding="utf-8")
    print(f"Wrote active-learning config: {out}")
    print(f"Edit the command templates, then: chemflow active-learn run {out}")
    return 0


def _run(args: argparse.Namespace) -> int:
    from chemflow.active_learning.workflow import run_loop

    return run_loop(Path(args.config), dry_run=args.dry_run)


def add_active_learn_parser(subparsers) -> None:
    parser = subparsers.add_parser(
        "active-learn",
        help="Active-learning virtual screening (Chemprop surrogate + Glide oracle)",
    )
    commands = parser.add_subparsers(dest="active_learn_command", required=True)

    gen = commands.add_parser("generate", help="Write a commented active-learning config")
    gen.add_argument("-o", "--output", type=Path, help="Output YAML (default: al.yaml)")
    gen.add_argument("--force", action="store_true", help="Overwrite an existing file")
    gen.set_defaults(func=_generate)

    run = commands.add_parser("run", help="Run the active-learning loop")
    run.add_argument("config", type=Path, help="Active-learning YAML config")
    run.add_argument("--dry-run", action="store_true",
                     help="Print each round's plan and commands without executing")
    run.set_defaults(func=_run)
