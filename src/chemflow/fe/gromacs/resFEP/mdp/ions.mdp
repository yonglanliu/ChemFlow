; ions.mdp
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 500

cutoff-scheme   = Verlet

nstlist         = 20
rlist           = 1.0
rcoulomb        = 1.0
rvdw            = 1.0

coulombtype     = PME
vdwtype         = Cut-off

pbc             = xyz

constraints     = none